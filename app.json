{
  "expo": {
    "name": "Daily English 10",
    "slug": "daily-english-10",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dailyenglish10",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
